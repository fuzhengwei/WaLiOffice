# WaLiOffice 配置示例
# 复制为 .env 后再启动服务：cp .env.example .env

AIPPT_APP_NAME="WaLiOffice"
AIPPT_HOST=0.0.0.0
AIPPT_PORT=8000

# 必填：生产环境必须使用足够长、随机的密钥
AIPPT_JWT_SECRET=change-me-to-a-long-random-secret
AIPPT_JWT_EXPIRY_HOURS=24

# 必填：OpenAI 兼容 LLM 端点
AIPPT_LLM_BASE_URL=http://127.0.0.1:8777/v1
AIPPT_LLM_API_KEY=change-me
AIPPT_LLM_MODEL=glm_for_coding
AIPPT_LLM_PROVIDER=glm-gateway
AIPPT_LLM_TOOL_TIMEOUT_MS=1800000
AIPPT_LLM_CHAT_TIMEOUT_MS=1800000

# 联网搜索源：auto | baidu_mcp | baidu | searxng | duckduckgo
AIPPT_WEB_SEARCH_PROVIDER=auto
# 当 provider=searxng 或 auto 时，会尝试这个地址；中文检索在 auto 下会优先走百度 MCP（如已配置），再回退百度网页
AIPPT_WEB_SEARCH_ENDPOINT=http://127.0.0.1:8080
AIPPT_WEB_SEARCH_TIMEOUT_MS=20000

# 百度 AI Search MCP（可选）
# 如果你自己部署，需要填写这个 key；为空时系统不会启用内置百度 MCP 检索增强
AIPPT_BAIDU_MCP_API_KEY=
AIPPT_BAIDU_MCP_SSE_ENDPOINT=http://appbuilder.baidu.com/v2/ai_search/mcp/sse

# 管理员账号
AIPPT_ADMIN_USERNAME=admin
AIPPT_ADMIN_PASSWORD=admin123

# 数据目录
AIPPT_DATA_DIR=data
AIPPT_PROJECTS_DIR=data/projects
AIPPT_SESSIONS_DIR=data/sessions
AIPPT_RENDER_OUTPUT_DIR=outputs

# CORS
AIPPT_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
